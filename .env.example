# Daraja B2C sandbox only. The application has no production Daraja endpoint.
DARAJA_B2C_ENABLED=false
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_INITIATOR_NAME=
DARAJA_SECURITY_CREDENTIAL=
DARAJA_SHORTCODE=
DARAJA_B2C_COMMAND_ID=BusinessPayment
# Public HTTPS URL that reaches this backend (for example, an HTTPS tunnel in development).
DARAJA_CALLBACK_BASE_URL=
# Generate locally with: python -c "import secrets; print(secrets.token_urlsafe(32))"
DARAJA_CALLBACK_TOKEN=
